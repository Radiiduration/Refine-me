{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Refine",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": { "all": false },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "identifier": "com.refine.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/256x256.png",
        "icons/512x512.png"
      ]
    },
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:8000; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "title": "Refine",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  }
}
